// Model: users/{Google-auth-uid}/entries/{auto-id}
// Required fields: date (YYYY-MM-DD), title (1..120), mood (enum), content
// (1..100000), createdAt (immutable timestamp), updatedAt (server timestamp).
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function validEntry() {
      let d = request.resource.data;
      return d.keys().hasAll(['date','title','mood','content','createdAt','updatedAt'])
        && d.keys().hasOnly(['date','title','mood','content','createdAt','updatedAt'])
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.content is string && d.content.size() > 0 && d.content.size() <= 100000
        && d.mood in ['좋음','평온','보통','지침','속상']
        && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    match /users/{uid}/entries/{id} {
      allow get: if owner(uid);
      allow list: if owner(uid) && request.query.limit != null && request.query.limit <= 200;
      allow create: if owner(uid) && validEntry() && request.resource.data.createdAt == request.time;
      allow update: if owner(uid) && validEntry() && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if owner(uid);
    }
    match /{document=**} { allow read, write: if false; }
  }
}
