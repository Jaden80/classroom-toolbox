{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["icn1"],
  "functions": {
    "api/index.ts": {"maxDuration": 30, "includeFiles": ["server/schema.sql"]}
  },
  "rewrites": [
    {"source": "/api/:path*", "destination": "/api/index"},
    {"source": "/teacher", "destination": "/index.html"},
    {"source": "/join", "destination": "/index.html"},
    {"source": "/history", "destination": "/index.html"},
    {"source": "/students", "destination": "/index.html"}
  ],
  "headers": [{"source": "/:path*", "headers": [
    {"key":"X-Content-Type-Options","value":"nosniff"},
    {"key":"Referrer-Policy","value":"no-referrer"},
    {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"}
  ]}]
}
