{
  "name": "classroom-quiz-race", "version": "1.0.0", "private": true, "type": "module",
  "engines": {"node": "24.x"},
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.ts",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "build": "tsc --noEmit && vite build --configLoader native",
    "test": "node --test tests/*.test.ts",
    "account:delete": "node --env-file-if-exists=.env server/manage-account.ts",
    "check": "npm run build && npm test"
  },
  "dependencies": {"exceljs": "4.4.0", "pg": "8.16.3", "nodemailer": "10.1.2"},
  "overrides": {"exceljs": {"uuid": "11.1.1"}},
  "devDependencies": {"@types/node": "^24.0.0", "@types/pg": "^8.15.0", "@types/nodemailer": "^7.0.0", "typescript": "^5.9.0", "vite": "^7.1.0"}
}
